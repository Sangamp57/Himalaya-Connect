# Copy this file to .env and adjust the values for your environment.
# The project loads .env automatically; environment variables win.

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

SITE_NAME=Himalaya Connect
DEFAULT_FROM_EMAIL=Himalaya Connect <hello@himalayaconnect.com>

# Development prints password-reset emails to the terminal.
# For real email, use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Optional live cultural guide. Leave the key blank for the curated
# offline knowledge base used by the explorer.
# The key is read only on the server; it is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Used only when running `python manage.py seed_content` on a fresh database.
SEED_ADMIN_PASSWORD=Admin@2026!
SEED_WRITER_PASSWORD=Himalaya2026!

# Production-only toggles
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
