# Copy this file to .env and adjust the values for your environment.
# The project loads .env automatically; environment variables win.

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

SITE_NAME=Himalaya Connect
DEFAULT_FROM_EMAIL=Himalaya Connect <hello@himalayaconnect.com>

# Development prints password-reset emails to the terminal.
# For real email, use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Social sign-in (optional). Configure the callback URLs exactly in each console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/accounts/google/callback/
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://your-domain.example/accounts/wechat/callback/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-domain.example/accounts/facebook/callback/

# Phone sign-in. The default prints codes to the server console in development.
SMS_BACKEND=console
SMS_SENDER=Himalaya Connect
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
PHONE_CODE_TTL_SECONDS=600

# Optional live cultural guide. Leave the key blank for the curated
# offline knowledge base used by the explorer.
# The key is read only on the server; it is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional passwords for the demo accounts created by `python manage.py seed_content`.
# Leave these blank to create the demo accounts with unusable passwords; set your own
# values only if you need to sign in as a demo author. Never commit a real .env file.
SEED_ADMIN_PASSWORD=
SEED_WRITER_PASSWORD=

# Production-only toggles
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
